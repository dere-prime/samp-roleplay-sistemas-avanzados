stock GetAnimIndexByName(const name[]) {
    for(new i = 0; i < sizeof(AnimList); i++) {
        if(!strcmp(AnimList[i][AnimName], name, true)) {
            return AnimList[i][AnimIndex];
        }
    }
    return -1; // No encontrado
}