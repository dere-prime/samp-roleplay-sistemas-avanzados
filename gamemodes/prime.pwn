	if (sscanf(params, "uf", to_player, amount)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/sethealth <player_id> <valor>");
	if (!IsPlayerConnected(to_player)) return SendPlayerClientMessage(playerid, "Jugador (%d) desconectado", to_player);
	if (amount < 0.0 || amount > 100.0) return SendPlayerClientMessage(playerid, "Valor no válido.");
	if (PI[to_player][pi_ADMIN_LEVEL] > PI[playerid][pi_ADMIN_LEVEL]) return SendPlayerClientMessage(playerid, "El rango administrativo de este jugador es superior al tuyo.");
	
	SetPlayerHealthEx(to_player, amount);
	SendPlayerClientMessage(playerid, "La vida de %s (%d) ahora es %.1f.", PI[to_player][pi_NAME], to_player, amount);
	
	SendCmdLogToAdmins(playerid, "sethealth", params);
	return 1;
}
