stock CountPolicesOnDuty() {
	new count = 0;
	foreach (new i : Player) {
		if (IsPlayerConnected(i)) {
			if (PLAYER_TEMP[i][pt_GAME_STATE] == GAME_STATE_NORMAL) {
				if (PLAYER_WORKS[i][WORK_POLICE][pwork_SET] && PLAYER_TEMP[i][pt_WORKING_IN] == WORK_POLICE) {
					count ++;
				}
			}
		}
	}
	return count;
}

