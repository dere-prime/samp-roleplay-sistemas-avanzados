						SendPlayerClientMessage(playerid, "Le has ofrecido a %s reparar el vehículo por %s$.", PLAYER_TEMP[buyer][pt_NAME], number_format_thousand(PLAYER_TEMP[buyer][pt_MECHANIC_PRICE]));
