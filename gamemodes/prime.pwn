CMD:setcash(playerid, params[]) {
	new to_player, value;
	if (sscanf(params, "ud", to_player, value)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/setcash <player_id> <amount>");
	if (!IsPlayerConnected(to_player)) return SendPlayerClientMessage(playerid, "Jugador (%d) desconectado", to_player);
