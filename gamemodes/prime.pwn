/* Macros */
#define IsPlayerWorking(%0,%1) (PLAYER_WORKS[%0][%1][pwork_SET]&&PLAYER_TEMP[%0][pt_WORKING_IN]==%1)
#define IsPlayerNotWorking(%0,%1) (PLAYER_TEMP[%0][pt_WORKING_IN]!=%1)
#define IsPlayerWork(%0,%1) (PLAYER_WORKS[%0][%1][pwork_SET])
#define IsVehicleWork(%0,%1) (GLOBAL_VEHICLES[%0][gb_vehicle_TYPE]==VEHICLE_TYPE_WORK&&WORK_VEHICLES[%0][work_vehicle_WORK]==%1)
#define PlayerTimeOut(%0,%1,%2,%3) if (gettime() < ((%0) + (%1))) return SendPlayerClientMessage((%2), (%3), TimeConvertAsText((%1) - (gettime() - (%0))))
#define ShowPlayerTimeOut(%0,%1,%2,%3) if (gettime() < ((%0) + (%1))) return ShowPlayerMessage((%2), (%3), TimeConvertAsText((%1) - (gettime() - (%0))))
#define SecondsToMs(%0) (%0*1000)

#define P_CURR "~g~$~w~~h~"
#define N_CURR "~r~$~w~~h~"

