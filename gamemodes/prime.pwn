stock GetPlayerCameraRotation(playerid,&Float:rx,&Float:rz){
	new Float:mx,Float:my,Float:mz;
	GetPlayerCameraFrontVector(playerid,mx,my,mz);
	rx = CompressRotation(-(acos(mz)-90.0));
	rz = CompressRotation((atan2(my,mx)-90.0));
}

stock Float:CompressRotation(Float:rotation){
	return (rotation - floatround(rotation/360.0,floatround_floor)*360.0);
}

CountCrewPlayers(id_crew) {
    mysql_format(handle_db, QUERY_BUFFER, sizeof QUERY_BUFFER, "SELECT COUNT(id) FROM player WHERE crew = %d;", id_crew);
    new count, Cache:result = mysql_query(handle_db, QUERY_BUFFER);
    cache_get_value_int(0, 0, count);
    cache_delete(result);
    return count;
}

stock GetRandomPropertyIndex() {
	new index = -1;
	while(index == -1) {
		new tmpIndex = random(MAX_PROPERTIES);
		if (PROPERTY_INFO[tmpIndex][property_VALID]) index = tmpIndex;
	}
	return index;
}

const RPC_VehicleDestroy = 136;
IRPC:RPC_VehicleDestroy(playerid, BitStream:bs) {
	if (ac_Info[CHEAT_DESTROY_VEHICLE][ac_Enabled]) {
		new vehicleid;
		BS_ReadUint16(bs, vehicleid);

		if (vehicleid <= 0 || vehicleid >= MAX_VEHICLES) {
			return 0;
		}

		if (PI[playerid][pi_LEVEL] < 3) {
			if ( (vehicleid == GetPlayerVehicleID(playerid) && GLOBAL_VEHICLES[vehicleid][gb_vehicle_DRIVER] == playerid) || (PLAYER_VEHICLES[vehicleid][player_vehicle_VALID] && PLAYER_VEHICLES[vehicleid][player_vehicle_OWNER_ID] == PI[playerid][pi_ID]) ) {
				return 1;
			}
			return 0;
		}

		if (!IsVehicleStreamedIn(vehicleid, playerid)) {
			return 0;
		}

		new interval = GetTickDiff(GetTickCount(), PLAYER_TEMP[playerid][pt_LAST_VEHICLE_DESTROY]);
		if (interval < 500) {
			new current_gettime = gettime();
			if (current_gettime > PLAYER_AC_INFO[playerid][CHEAT_DESTROY_VEHICLE][p_ac_info_IMMUNITY]) {
				if (!ac_Info[CHEAT_DESTROY_VEHICLE][ac_Interval]) OnPlayerCheatDetected(playerid, CHEAT_DESTROY_VEHICLE);
				else {
					if (current_gettime - PLAYER_AC_INFO[playerid][CHEAT_DESTROY_VEHICLE][p_ac_info_LAST_DETECTION] > ac_Info[CHEAT_DESTROY_VEHICLE][ac_Interval]) PLAYER_AC_INFO[playerid][CHEAT_DESTROY_VEHICLE][p_ac_info_DETECTIONS] = 0;
					else PLAYER_AC_INFO[playerid][CHEAT_DESTROY_VEHICLE][p_ac_info_DETECTIONS] ++;
					
					PLAYER_AC_INFO[playerid][CHEAT_DESTROY_VEHICLE][p_ac_info_LAST_DETECTION] = current_gettime;
					if (PLAYER_AC_INFO[playerid][CHEAT_DESTROY_VEHICLE][p_ac_info_DETECTIONS] >= ac_Info[CHEAT_DESTROY_VEHICLE][ac_Detections]) OnPlayerCheatDetected(playerid, CHEAT_DESTROY_VEHICLE);
				}
			}
			return 0;
		}
		PLAYER_TEMP[playerid][pt_LAST_VEHICLE_DESTROY] = GetTickCount();
	}
    return 1;
}

GetVehicleComponentIndexFromId(vehicleid, id) {
	for(new i = 0; i != MAX_VEHICLE_COMPONENTS; i ++) {
		if (GLOBAL_VEHICLES[vehicleid][gb_vehicle_COMPONENTS][i] && GLOBAL_VEHICLES[vehicleid][gb_vehicle_COMPONENTS][i] == id) {
			return i;
		}
	}
	return -1;
}

stock GetTerritoryIndexById(id) {
	for(new i = 0; i != MAX_TERRITORIES; i ++) {
		if (TERRITORIES[i][territory_VALID] && TERRITORIES[i][territory_ID] == id) return i;
	}
	return -1;
}

stock strcatf(dest[], const fmat[], GLOBAL_TAG_TYPES:...) {
	if (YSI_CheckNumargs__(2)) return strcat(dest, __const(fmat), YSI_UNSAFE_HUGE_LENGTH);
	return
		format(YSI_UNSAFE_HUGE_STRING, YSI_UNSAFE_HUGE_LENGTH, fmat, ___(2)),
		strcat(dest, YSI_UNSAFE_HUGE_STRING, YSI_UNSAFE_HUGE_LENGTH);
}

stock GetPlayerAltitude(const playerid, &Float:altitude) {
    new Float:x, Float:y, Float:z, Float:z_terrain;
    GetPlayerPos(playerid, x, y, z);
    CA_FindZ_For2DCoord(x, y, z_terrain);
    altitude = z - z_terrain;
    return 1;
}

public LoadNPCMovementPath() {
	/* Register Path */
	a_register_path = FCNPC_CreateMovePath();
	FCNPC_AddPointsToMovePath(a_register_path, a_register_npc_movement_path);
	b_register_path = FCNPC_CreateMovePath();
	FCNPC_AddPointsToMovePath(b_register_path, b_register_npc_movement_path);
	return Y_HOOKS_CONTINUE_RETURN_1;
}

public FCNPC_OnCreate(npcid) {
	PLAYER_TEMP[npcid][pt_REGISTER_NPC_PLAYER] = INVALID_PLAYER_ID;
	return Y_HOOKS_CONTINUE_RETURN_1;
}

public FCNPC_OnFinishMovePath(npcid, pathid) {
	new playerid = INVALID_PLAYER_ID;
	if (PLAYER_TEMP[npcid][pt_REGISTER_NPC_PLAYER] != INVALID_PLAYER_ID) {
		playerid = PLAYER_TEMP[npcid][pt_REGISTER_NPC_PLAYER];

		switch(PLAYER_TEMP[playerid][pt_REGISTER_NPC_CURRENT]) {
			case 0: {
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][0]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][1]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][2]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][3]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][4]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][5]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][6]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][7]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][8]);
				PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][9]);
				PLAYER_TEMP[playerid][pt_REGISTER_NPC_CURRENT] = -1;
				FCNPC_SetPosition(npcid, a_register_npc_movement_path[3][0], a_register_npc_movement_path[3][1], a_register_npc_movement_path[3][2]);
				FCNPC_SetAngle(npcid, 180.0);
			}
			case 1, 2: {
				FCNPC_SetPosition(npcid, a_register_npc_movement_path[0][0], a_register_npc_movement_path[0][1], a_register_npc_movement_path[0][2]);
				FCNPC_SetSkin(npcid, Intro_Skins[PI[playerid][pi_GENDER]][PLAYER_TEMP[playerid][pt_REGISTER_SELECTED_SKIN]]);
				if (PLAYER_TEMP[playerid][pt_REGISTER_NPC_CURRENT] == 2) FCNPC_GoByMovePath(PLAYER_TEMP[playerid][pt_REGISTER_NPC], a_register_path, .type = FCNPC_MOVE_TYPE_RUN);
				else FCNPC_GoByMovePath(PLAYER_TEMP[playerid][pt_REGISTER_NPC], a_register_path, .type = FCNPC_MOVE_TYPE_WALK);
				PLAYER_TEMP[playerid][pt_REGISTER_NPC_CURRENT] = 0;
			}
		}
		return 1;
	}

	return Y_HOOKS_CONTINUE_RETURN_1;
}

stock ShowPlayerBlackScreen(playerid) {
	TextDrawShowForPlayer(playerid, Textdraws[textdraw_BLACK_SCREEN]);
	return 1;
}

stock HidePlayerBlackScreen(playerid) {
	TextDrawHideForPlayer(playerid, Textdraws[textdraw_BLACK_SCREEN]);
	return 1;
}

stock EaseShowPlayerBlackScreen(playerid, duration = 1000) {
	TextDrawHideForPlayer(playerid, Textdraws[textdraw_BLACK_SCREEN]);
	PLAYER_TEMP[playerid][pt_BLACK_SCREEN_ANIMATOR] = PlayerText_InterpolateBoxColor(playerid, PlayerTextdraws[playerid][ptextdraw_BLACK_SCREEN], 0x000000FF, duration, EASE_IN_OUT_SINE);
	return 1;
}

stock EaseHidePlayerBlackScreen(playerid, duration = 1000) {
	TextDrawHideForPlayer(playerid, Textdraws[textdraw_BLACK_SCREEN]);
	PLAYER_TEMP[playerid][pt_BLACK_SCREEN_ANIMATOR] = PlayerText_InterpolateBoxColor(playerid, PlayerTextdraws[playerid][ptextdraw_BLACK_SCREEN], 0x00000000, duration, EASE_IN_OUT_SINE);
	return 1;
}

forward UpdateCallingCardTime(playerid);
public UpdateCallingCardTime(playerid) {
	PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIME] ++;
	va_PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][3], "%s", TimeConvert(PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIME]));
	if (PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_STATE] == CALL_STATE_ESTABLISHED) {
		KillTimer(PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIMER]);
		PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIMER] = SetTimerEx("UpdateCallingCardTime", 1000, false, "i", playerid);
	}
	return 1;
}
UpdatePlayerCallingCard(const playerid, number = 0) {
	if (number > 0) PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][4], convertPhoneNumber(playerid, number));
	switch (PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_STATE]) {
		case CALL_GAME_STATE_NONE: HidePlayerCallingCard(playerid);
		case CALL_STATE_WAITING_RESPONSE: PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][3], "LLamando...");
		case CALL_STATE_INCOMING_CALL: PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][3], "LLamada entrante...");
		case CALL_STATE_ESTABLISHED: {
			PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][3], "00:00");
			KillTimer(PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIMER]);
			PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIMER] = SetTimerEx("UpdateCallingCardTime", 1000, false, "i", playerid);
		}
	}
	return 1;
}
ShowPlayerCallingCard(const playerid) {
	for (new i = 0; i != 6; i ++) {
		PlayerTextDrawShow(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][i]);
	}
	return 1;
}
HidePlayerCallingCard(const playerid) {
	PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][3], "_");
	PlayerTextDrawSetString(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][4], "_");
	
	KillTimer(PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_TIMER]);

	for (new i = 0; i != 6; i ++) {
		PlayerTextDrawHide(playerid, PlayerTextdraws[playerid][ptextdraw_CALLING_CARD][i]);
	}
	return 1;
}
StartPlayerCallUsingPhoneNumber(const playerid, const selected_number) {
	if (!HandleStaticPhoneNumbers(playerid, selected_number)) {
		inline OnPhoneChecked() {
			new rows;
			if (cache_get_row_count(rows)) {
				if (rows) {
					new id, connected, pid;
					cache_get_value_name_int(0, "id_player", id);
					cache_get_value_name_int(0, "connected", connected);
					cache_get_value_name_int(0, "pid", pid);

					if (!connected) SendPlayerClientMessage(playerid, "{666666}El número al que intentas llamar está fuera de cobertura (desconectado).");
					else {
						if (pid == playerid) return SendPlayerClientMessage(playerid, "{666666}El número al que intentas llamar es el tuyo.");
						if (PI[pid][pi_PHONE_STATE] == PHONE_STATE_OFF) return SendPlayerClientMessage(playerid, "{666666}El número al que intentas llamar está apagado o fuera de cobertura.");
						if (PLAYER_TEMP[pid][pt_PLAYER_IN_CALL]) return SendPlayerClientMessage(playerid, "{666666}El número al que intentas llamar está en otra llamada.");
						
						SendPlayerClientMessage(pid, "{00BFFF}[Llamada entrante]{FFFFFF} » {00BFFF}·{FFFFFF}%s te esta llamando.", convertPhoneNumber(pid, GetValidPlayerPhoneNumber(playerid)));
						SendPlayerClientMessage(pid, "{00BFFF}·{FFFFFF}Usa {00FF00}/responder {FFFFFF}para atender o {FF4444}/colgar {FFFFFF}para rechazar.");
						
						PLAYER_TEMP[pid][pt_PLAYER_IN_CALL] = true;
						PLAYER_TEMP[pid][pt_PLAYER_PHONE_CALL_STATE] = CALL_STATE_INCOMING_CALL;
						PLAYER_TEMP[pid][pt_PLAYER_PHONE_CALL_PLAYERID] = playerid;
						UpdatePlayerCallingCard(pid, GetValidPlayerPhoneNumber(playerid));
						ShowPlayerCallingCard(pid);

						new str_text[64];
						format(str_text, sizeof(str_text), "* El telefono de %s esta sonando...", PLAYER_TEMP[pid][pt_NAME]);
						ProxDetector(pid, 15.0, str_text, 0xADFF2FAA, 0xADFF2FAA, 0xADFF2FAA, 0xADFF2FAA, 0xADFF2FAA, 85);
						PlayerPlaySoundEx(pid, 20804);
						
						SendPlayerClientMessage(playerid, "{00BFFF}·{FFFFFF}Llamando a {00BFFF}%s{FFFFFF}...", convertPhoneNumber(playerid, selected_number));
						PLAYER_TEMP[playerid][pt_TIMERS][6] = SetTimerEx("NoCallResponse", 15000, false, "i", playerid);
						PLAYER_TEMP[playerid][pt_PLAYER_IN_CALL] = true;
						PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_STATE] = CALL_STATE_WAITING_RESPONSE;
						PLAYER_TEMP[playerid][pt_PLAYER_PHONE_CALL_PLAYERID] = pid;
						UpdatePlayerCallingCard(playerid, selected_number);
						ShowPlayerCallingCard(playerid);
						PlayerPlaySoundEx(playerid, 3600, 0.0, 0.0, 0.0);
					}
				}
				else SendPlayerClientMessage(playerid, "{666666}El número destino no es válido.");
			}
		}
		mysql_format(handle_db, QUERY_BUFFER, sizeof QUERY_BUFFER, "SELECT player.id AS id_player, player.connected AS connected, player.playerid AS pid, player_inventory.id_player, player_inventory.type, player_inventory.data FROM player_inventory LEFT JOIN player ON player.id = player_inventory.id_player WHERE player_inventory.type = %d AND player_inventory.data = %d;", INVENTORY_PHONE, selected_number);
		MySQL_TQueryInline(handle_db, using inline OnPhoneChecked, QUERY_BUFFER);
	}
	return 1;
}

stock GetPlayerNearVehicle(playerid, Float:radi = 5.0) {
	if (!IsPlayerConnected(playerid)) return INVALID_VEHICLE_ID;

	new vehicle = INVALID_VEHICLE_ID, Float:PosPlayer[3];
	GetPlayerPos(playerid, PosPlayer[0], PosPlayer[1], PosPlayer[2]);

	for (new i; i < MAX_VEHICLES; i++) {
		if (GLOBAL_VEHICLES[i][gb_vehicle_VALID]) {
			new Float:PosVehicle[3], Float:PosRelative[3], Float:tempDis;
			GetVehiclePos(i, PosVehicle[0], PosVehicle[1], PosVehicle[2]);

			for (new z; z < sizeof(PosVehicle); z++) {
				PosRelative[z] = PosVehicle[z] - PosPlayer[z];
			}
				
			tempDis = floatsqroot((floatpower(PosRelative[0], 2)) + (floatpower(PosRelative[1], 2)) + (floatpower(PosRelative[2], 2)));

			if (tempDis <= radi) {
				radi = tempDis;
				vehicle = i;
			}
		}
	}
	return vehicle;
}

