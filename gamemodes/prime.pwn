	return 1;
}

CMD:pexp(playerid, params[]) {
	new to_player;
	if (sscanf(params, "u", to_player)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/pexp <player_id>");
	if (!IsPlayerConnected(to_player)) return SendPlayerClientMessage(playerid, "Jugador (%d) desconectado", to_player);
	if (PI[to_player][pi_ADMIN_LEVEL] > PI[playerid][pi_ADMIN_LEVEL]) return SendPlayerClientMessage(playerid, "El rango administrativo de este jugador es superior al tuyo.");
	
	ShowPlayerSkills(playerid, to_player);
	return 1;
}

CMD:pbank(playerid, params[]) {
	new to_player;
	if (sscanf(params, "u", to_player)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/pbank <player_id>");
	if (!IsPlayerConnected(to_player)) return SendPlayerClientMessage(playerid, "Jugador (%d) desconectado", to_player);
	if (PI[to_player][pi_ADMIN_LEVEL] > PI[playerid][pi_ADMIN_LEVEL]) return SendPlayerClientMessage(playerid, "El rango administrativo de este jugador es superior al tuyo.");
	
	if (!PI[to_player][pi_BANK_ACCOUNT]) SendPlayerClientMessage(playerid, "El jugador no tiene cuenta bancaria.");
	else SendPlayerClientMessage(playerid, "Cuenta bancaria ID: '%d' Balance: '%s'", PI[to_player][pi_BANK_ACCOUNT], number_format_thousand(PI[to_player][pi_BANK_MONEY]));
	return 1;
}

CMD:unjail(playerid, params[]) {
	new to_player;
	if (sscanf(params, "u", to_player)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/unjail <player_id>");
	if (!IsPlayerConnected(to_player)) return SendPlayerClientMessage(playerid, "Jugador (%d) desconectado", to_player);
	if (PI[to_player][pi_ADMIN_LEVEL] > PI[playerid][pi_ADMIN_LEVEL]) return SendPlayerClientMessage(playerid, "El rango administrativo de este jugador es superior al tuyo.");
	
	if (PI[to_player][pi_STATE] != ROLEPLAY_STATE_JAIL) return SendPlayerClientMessage(playerid, "El jugador no está en el cárcel.");
	
	UnjailPlayer(to_player);
	SendPlayerClientMessage(playerid, "El jugador %s (%d) ahora está en libertad.", PI[to_player][pi_NAME], to_player);
	
	
	SendCmdLogToAdmins(playerid, "unjail", params);
	return 1;
}

CMD:ip(playerid, params[]) {
	new to_player;
	if (sscanf(params, "u", to_player)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/ip <player_id>");
	if (!IsPlayerConnected(to_player)) return SendPlayerClientMessage(playerid, "Jugador (%d) desconectado", to_player);
	if (PI[to_player][pi_ADMIN_LEVEL] > PI[playerid][pi_ADMIN_LEVEL]) return SendPlayerClientMessage(playerid, "El rango administrativo de este jugador es superior al tuyo.");

	SendPlayerClientMessage(playerid, "IP %s (%d): %s", PI[to_player][pi_NAME], to_player, PI[to_player][pi_IP]);
	return 1;
}

CMD:traerveh(playerid, params[]) {
	new to_car;
	if (sscanf(params, "i", to_car)) return ShowPlayerMessage(playerid, "Parametros incorrectos, usa ~y~/traerveh <car_id>");
	if (to_car >= MAX_VEHICLES) return 1;

	if (!GLOBAL_VEHICLES[to_car][gb_vehicle_VALID]) return SendPlayerClientMessage(playerid, "Vehículo no válido.");
	if (GLOBAL_VEHICLES[to_car][gb_vehicle_OCCUPIED]) return SendPlayerClientMessage(playerid, "Vehículo está ocupado.");
		
    new Float:gPos[3];
    GetPlayerPos(playerid, gPos[0], gPos[1], gPos[2]);
    SetVehiclePosEx(to_car, gPos[0] + 2.0, gPos[1], gPos[2]);
    return 1;
}
alias:traerveh("mover", "getveh", "traervehiculo", "traerauto", "getcar");


