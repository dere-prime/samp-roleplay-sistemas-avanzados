				FCNPC_GoByMovePath(PLAYER_TEMP[playerid][pt_REGISTER_NPC], a_register_path, .type = FCNPC_MOVE_TYPE_RUN);
			} else if (PLAYER_TEMP[playerid][pt_REGISTER_NPC_CURRENT] == -1) {
				PLAYER_TEMP[playerid][pt_REGISTER_NPC_CURRENT] = 2;
				FCNPC_GoByMovePath(PLAYER_TEMP[playerid][pt_REGISTER_NPC], b_register_path, .type = FCNPC_MOVE_TYPE_RUN);
			}
			return 1;
		}
		else if (playertextid == PlayerTextdraws[playerid][ptextdraw_REGISTER_SKIN][8]) // Anterior ropa
