				PlayerPlaySoundEx(playerid, 1085, 0.0, 0.0, 0.0);
				SendPlayerClientMessage(playerid, "No tienes dinero suficiente, te faltan %s$ para poder comprar esta ropa.", number_format_thousand(clothe_info[2] - PI[playerid][pi_CASH]));
